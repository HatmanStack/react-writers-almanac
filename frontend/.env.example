# API Configuration
# Copy this file to .env and replace with your actual values

# Base URL for API Gateway endpoints (Lambda functions)
# Set automatically by deploy script, or manually configure
VITE_API_BASE_URL=

# CloudFront CDN URL for static content (poems, authors)
VITE_CDN_BASE_URL=

# S3 bucket name for storing JSON data
VITE_S3_BUCKET=

# AWS Region where resources are deployed
VITE_AWS_REGION=
