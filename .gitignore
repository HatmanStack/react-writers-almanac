# Generated hook shims. lefthook.yml is the hook source of truth; `lefthook
# install` (via postinstall) provisions .git/hooks/, which git never tracks.
# A .husky/ directory here would be a generated shim embedding an absolute
# developer path -- exactly what was removed in the 2026-08-09 remediation.
.husky/

# One lockfile governs the workspace; a frontend lockfile drifts from it
frontend/package-lock.json

# Agent tooling state
.claude/

# 22 MB source dataset for scripts/split-poets-json.js — not consumed by the app.
# Untracked, but still present in git history, so clone size is unchanged by this
# entry. Removing it from history would take a filter-repo rewrite and a
# force-push, invalidating every existing clone, fork and open PR -- an
# outward-facing action deliberately left to the repository owner.
/poets.json

# Legacy (can be removed after cleanup)
/public/holder
/public/json
/archive
/scrape_data
awsconfiguration.json
amplifyconfiguration.json
aws-exports.js
todolist
scp.txt
cleaning.py
moving.py
